{
  "name": "lale-next",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Lean verification for Overleaf",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @lale/extension dev",
    "build:ext": "pnpm --filter @lale/extension build",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --filter @lale/desktop dev",
    "evals": "pnpm --filter @lale/desktop evals",
    "test": "pnpm --filter @lale/desktop test"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.6.3"
  }
}
